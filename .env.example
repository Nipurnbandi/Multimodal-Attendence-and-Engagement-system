# Multimodal Attendance & Engagement Agent Configuration
# Database
DATABASE_URL=sqlite:///./data/attendance_engagement.db

# Processing Settings
SUSTAINED_PRESENCE_THRESHOLD_SEC=15.0
PRESENCE_RATIO_THRESHOLD=0.5
INTERVAL_DURATION_SEC=60.0
FRAME_SAMPLE_RATE=2

# Engagement Formula Weights (Must sum to 1.0)
WEIGHT_FRONTAL_ATTENTION=0.40
WEIGHT_MOVEMENT_ACTIVITY=0.25
WEIGHT_AUDIO_ACTIVITY=0.20
WEIGHT_PRESENCE_CONTINUITY=0.15

# Optional LLM Integration (Fallback to local rule-based expert engine if left empty)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
USE_LOCAL_AGENT=true
